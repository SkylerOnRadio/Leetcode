#include <iostream>
#include <vector>

int brute(std::vector<int> &nums) {

  for (int i = 0; i < nums.size() - 1; ++i) {
    for (int j = i + 1; j < nums.size(); ++j) {
      if (nums.at(i) == nums.at(j))
        return nums.at(i);
    }
  }
  return -1;
}

int dupli(std::vector<int> &nums) {
  int s1 = nums.at(0);
  int fast = nums.at(0);

  while (s1 != fast) {
    s1 = nums.at(s1);
    fast = nums.at(nums.at(fast));
  }

  int s2 = nums.at(0);

  while (s1 != s2) {
    s1 = nums.at(s1);
    s2 = nums.at(s2);
  }

  return s1;
}

int main(int argc, char *argv[]) {
  std::vector<std::vector<int>> test_cases = {{1, 3, 4, 2, 2},
                                              {3, 1, 3, 4, 2},

                                              {1, 1},

                                              {2, 2, 1},
                                              {1, 2, 3, 4, 4},

                                              {3, 3, 3, 3, 3},

                                              {1, 4, 2, 4, 3, 4},

                                              {5, 1, 6, 2, 7, 3, 8, 4, 9, 9}};

  for (auto vect : test_cases) {
    std::cout << dupli(vect) << "\n";
  }

  return 0;
}
